# Phrasia is anonymous-first: no provider API keys are required.
# Entries here are optional overrides; the catalog in backend/providers/catalog.py wins unless
# a key is saved in Settings.

PROVIDER_TIMEOUT_SECONDS=60
HUMANIZE_CHUNK_CHARS=2560
MAX_INPUT_CHARS=200000
MAX_UPLOAD_BYTES=20971520

PHRASIA_PORT=8000

# Optional: to try a custom OpenAI-compatible endpoint add CUSTOM_API_KEY,
# CUSTOM_MODEL and CUSTOM_BASE_URL.
