{
  "rewrites": [
    {
      "source": "/api/*",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/app/$1"
    }
  ],
  "functions": {
    ".vercel/functions/api.func/index.js": {
      "runtime": "edge"
    }
  },
  "buildCommand": "python -m reflex export --frontend-only && cp -r .web/* ../_out/",
  "outputDirectory": "_out",
  "framework": null
}